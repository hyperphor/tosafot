{
  "manifest_version": 3,
  "name": "Tosafot",
  "version": "0.3.0",
  "minimum_chrome_version": "105",
  "homepage_url": "https://github.com/hyperphor/tosafot",
  "description": "Select text on any page and ask an LLM about it.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {"service_worker": "js/background/background.js"},
  "content_scripts": [
    {"matches": ["<all_urls>"],
     "js": ["js/content/content.js"],
     "run_at": "document_idle"}
  ],
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png",
            "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "options_page": "options.html",
  "action": {"default_title": "Ask Tosafot about the selection",
             "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}},
  "commands": {
    "ask-selection": {
      "suggested_key": {"default": "Alt+Shift+A"},
      "description": "Ask about the selected text"
    }
  }
}
